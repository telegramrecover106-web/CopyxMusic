{
  "name": "COPYxMUSIC",
  "description": "COPYxMUSIC — High quality Telegram VC music bot",
  "repository": "https://github.com",
  "keywords": ["telegram", "music", "bot", "vc", "python"],
  "stack": "container",
  "env": {
    "API_ID": {
      "description": "Telegram API_ID from https://my.telegram.org",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API_HASH from https://my.telegram.org",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Bot token from @BotFather",
      "required": true
    },
    "ASSISTANT_SESSION": {
      "description": "Pyrogram string session for assistant account",
      "required": true
    },
    "OWNER_ID": {
      "description": "Your Telegram user ID",
      "required": true
    },
    "SEARCH_API_URL": {
      "description": "Optional search API URL",
      "required": false
    },
    "DOWNLOAD_API_BASE": {
      "description": "Optional download API base",
      "required": false
    },
    "YOUTUBE_COOKIES": {
      "description": "Optional YouTube cookies",
      "required": false
    }
  }
}
